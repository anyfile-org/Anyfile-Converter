{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnyFile Convert",
  "version": "1.0.3",
  "identifier": "com.anyfileconvert.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AnyFile Converter",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "AnyFile Org",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/anyfile-converter/Anyfile-Converter/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCQTc2ODJFMUZENDA0MUEKUldRYUJOUWZMbWluMjErcXc0RWQySnhTMmdMdzhDcG16bEFJK21qc1FwVHo0L3Y2bHRVVTcrVlYK"
    }
  }
}